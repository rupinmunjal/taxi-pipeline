# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real credentials or project IDs here.

# --- Required ---------------------------------------------------------------

# GCS bucket used for raw and processed data.
GCS_BUCKET=your-gcs-bucket-name

# GCP project ID containing the destination BigQuery dataset.
BQ_PROJECT=your-gcp-project-id

# BigQuery dataset that holds the destination table.
BQ_DATASET=taxi_analytics

# --- Optional (defaults shown) ----------------------------------------------

# BQ_TABLE=trips
# GCS_RAW_PREFIX=raw/
# GCS_PROCESSED_PREFIX=processed/
# LOCAL_RAW_DIR=data/raw/
# LOCAL_PROCESSED_DIR=data/processed/
# EXPECTED_PICKUP_START_DATE=2026-05-01
# EXPECTED_PICKUP_END_DATE=2026-06-01

# --- Authentication ----------------------------------------------------------
# Google Cloud clients pick up credentials automatically via Application
# Default Credentials (ADC). Either:
#   - run `gcloud auth application-default login`, or
#   - place a service account key in ./secrets/ and set:
# GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
